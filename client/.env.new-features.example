# Study Sphere - New Features Environment Variables

# Feature Flags
REACT_APP_USE_CODEMIRROR=false
REACT_APP_USE_DAILY_VIDEO=false
REACT_APP_USE_UNIFIED_PRESENCE=false

# Y-WebSocket Server
REACT_APP_YJS_SERVER_URL=ws://localhost:1234

# Daily.co Video (get from https://dashboard.daily.co)
