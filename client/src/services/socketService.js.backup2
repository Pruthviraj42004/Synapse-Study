// Whiteboard events
export const sendWhiteboardUpdate = (roomId, drawingData) => {
  if (socket && socket.connected) {
    console.log('[SocketService] Sending whiteboard update to room:', roomId, 'Socket connected:', socket.connected, 'Socket ID:', socket.id);
    socket.emit('whiteboard_update', { roomId, drawingData });
  } else {
    console.error('[SocketService] Cannot send whiteboard update - socket not connected');
  }
};

export const onWhiteboardUpdate = (callback) => {
  if (socket) {
    socket.on('whiteboard_update', callback);
  }
};

export const offWhiteboardUpdate = () => {
