// Clean up event listeners
export const removeAllListeners = () => {
  if (socket) {
    socket.removeAllListeners();
  }
};

const socketService = {
  initializeSocket,
  getSocket,
  disconnectSocket,
  joinRoom,
  leaveRoom,
  sendMessage,
  onNewMessage,
  offNewMessage,
  startTyping,
  stopTyping,
  onUserTyping,
  onUserStoppedTyping,
  sendWhiteboardUpdate,
  onWhiteboardUpdate,
  offWhiteboardUpdate,
  sendCursorUpdate,
  onCursorUpdate,
  onUserJoined,
  onUserLeft,
  onUserStatusChanged,
  getSocketStatus,
  shareFile,
  deleteFile,
  shareNote,
  updateNote,
  onNewFile,
  onFileDeleted,
  onNoteShared,
  onNoteUpdated,
  startVideoCall,
  endVideoCall,
  onVideoCallStarted,
  onVideoCallEnded,
  startScreenShare,
  stopScreenShare,
  onScreenShareStarted,
  onScreenShareStopped,
  // Code collaboration
  joinCodeSession,
  leaveCodeSession,
  sendCodeUpdate,
  executeCodeRequest,
  sendExecutionResult,
  onCodeUpdated,
  offCodeUpdated,
  onUserJoinedSession,
  onUserLeftSession,
  onCodeExecutionStarted,
  onCodeExecutionCompleted,
  // Error and event handling
  onError,
  removeAllListeners,
  on: (event, callback) => socket?.on(event, callback),
  off: (event) => socket?.off(event),
  emit: (event, data) => socket?.emit(event, data)
};

export default socketService;