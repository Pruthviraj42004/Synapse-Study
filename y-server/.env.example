# Y-WebSocket Server Configuration

# Server
PORT=1234
NODE_ENV=development

# Authentication (optional - set to enable JWT validation)
# JWT_SECRET=your_jwt_secret_here
REQUIRE_AUTH=false

# Redis Configuration (for persistence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ENABLE_PERSISTENCE=true

# Snapshot Configuration
SNAPSHOT_INTERVAL=60000
SNAPSHOT_CLEANUP_AGE=86400000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
LOG_LEVEL=info
