{
    "name": "study-sphere-yjs-server",
    "version": "1.0.0",
    "description": "Y-WebSocket server for Study Sphere collaborative editing",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "docker:build": "docker build -t study-sphere-yjs .",
        "docker:run": "docker run -p 1234:1234 -e NODE_ENV=production study-sphere-yjs"
    },
    "keywords": [
        "yjs",
        "websocket",
        "collaborative",
        "crdt"
    ],
    "author": "Study Sphere Team",
    "license": "MIT",
    "dependencies": {
        "ws": "^8.14.2",
        "y-websocket": "^1.5.0",
        "yjs": "^13.6.8",
        "ioredis": "^5.3.2",
        "dotenv": "^16.3.1",
        "jsonwebtoken": "^9.0.2",
        "cors": "^2.8.5"
    },
    "devDependencies": {
        "nodemon": "^3.0.1"
    },
    "engines": {
        "node": ">=16.0.0"
    }
}